<Window x:Class="Vylersant_Facturacion.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xml:lang="es-DO"
        Title="Vylersant Facturación" Height="740" Width="1200" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="#F3F5F8" WindowStyle="None" ResizeMode="CanResize"
        StateChanged="Window_StateChanged"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ============ Paleta ============ -->
        <SolidColorBrush x:Key="Ink" Color="#172A3A" />
        <SolidColorBrush x:Key="InkSoft" Color="#294354" />
        <SolidColorBrush x:Key="InkHover" Color="#36556A" />
        <SolidColorBrush x:Key="Teal" Color="#0E8A83" />
        <SolidColorBrush x:Key="TealDark" Color="#0B726C" />
        <SolidColorBrush x:Key="TealPressed" Color="#095E59" />
        <SolidColorBrush x:Key="TealMint" Color="#63D0C4" />
        <SolidColorBrush x:Key="TealTint" Color="#E6F5F3" />
        <SolidColorBrush x:Key="Muted" Color="#657584" />
        <SolidColorBrush x:Key="Subtle" Color="#7A8996" />
        <SolidColorBrush x:Key="Line" Color="#E3E9EE" />
        <SolidColorBrush x:Key="Tile" Color="#F7F9FB" />
        <SolidColorBrush x:Key="Danger" Color="#B42318" />
        <SolidColorBrush x:Key="DangerTint" Color="#FDECEA" />
        <SolidColorBrush x:Key="Success" Color="#12B76A" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- ============ Iconos (Segoe MDL2 Assets) ============ -->
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ============ Campos de texto ============ -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D3DCE3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#9FB0BD" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Teal}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputPassword" TargetType="PasswordBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D3DCE3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#9FB0BD" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Teal}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Botones ============ -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Teal}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TealDark}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TealPressed}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TealDark}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D5DFE5" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="#3B5568" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InkSoft}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InkHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TealTint}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Teal}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CDEBE7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerIconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{StaticResource Subtle}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerTint}" />
                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Foreground" Value="#E7EEF2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#294354" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#36556A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Foreground" Value="#E7EEF2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C9372C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A82D24" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tarjeta de producto: toda la tarjeta es un botón grande -->
        <Style x:Key="ProductCard" TargetType="Button">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Tile}" BorderBrush="{StaticResource Line}" BorderThickness="1.5"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Teal}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TealTint}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CDEBE7" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Teal}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Navegación lateral (RadioButton: marca la sección activa sin código) ============ -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C3D0D8" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="Indicator" Width="4" Height="20" CornerRadius="2" HorizontalAlignment="Left"
                                        Margin="-14,0,0,0" Background="{StaticResource TealMint}" Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#203747" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InkSoft}" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Tarjeta base ============ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título con controles de ventana -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="{StaticResource Ink}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="7" Background="{StaticResource Teal}">
                    <TextBlock Text="V" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Vylersant Facturación" Foreground="White" FontWeight="SemiBold" FontSize="12" Margin="9,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource WindowControlButton}" ToolTip="Minimizar" AutomationProperties.Name="Minimizar"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinimizeWindow_Click">
                    <TextBlock Text="—" FontFamily="Segoe UI Symbol" FontSize="17" FontWeight="SemiBold" />
                </Button>
                <Button x:Name="WindowStateButton" Style="{StaticResource WindowControlButton}" ToolTip="Maximizar" AutomationProperties.Name="Maximizar"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="ToggleWindowState_Click">
                    <TextBlock x:Name="WindowStateIcon" Text="□" FontFamily="Segoe UI Symbol" FontSize="15" />
                </Button>
                <Button Style="{StaticResource CloseWindowControlButton}" ToolTip="Cerrar" AutomationProperties.Name="Cerrar"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseWindow_Click">
                    <TextBlock Text="×" FontFamily="Segoe UI Symbol" FontSize="19" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===================== LOGIN ===================== -->
        <Grid x:Name="LoginPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#172A3A" Offset="0" />
                    <GradientStop Color="#0F5F5B" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Border Width="440" Padding="40,36" Background="White" CornerRadius="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.28" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,26">
                        <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource Teal}">
                            <TextBlock Text="V" Foreground="White" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Vylersant" Foreground="{StaticResource Ink}" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="Facturación para tu comercio" Foreground="{StaticResource Muted}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Inicia sesión" Foreground="{StaticResource Ink}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Entra para facturar y revisar tus ventas." Foreground="{StaticResource Muted}" Margin="0,6,0,26" TextWrapping="Wrap" />

                    <TextBlock Text="Correo electrónico" Foreground="{StaticResource Ink}" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <TextBox x:Name="EmailTextBox" Style="{StaticResource Input}" />

                    <TextBlock Text="Contraseña" Foreground="{StaticResource Ink}" FontWeight="SemiBold" Margin="0,18,0,7" />
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPassword}" />

                    <!-- El aviso solo aparece cuando hay un mensaje -->
                    <Border Background="{StaticResource DangerTint}" CornerRadius="10" Padding="12,10" Margin="0,16,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=LoginErrorText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="LoginErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" FontSize="13" />
                    </Border>

                    <Button x:Name="LoginButton" Content="Entrar" Style="{StaticResource PrimaryButton}"
                            IsDefault="True" Margin="0,22,0,0" Click="Login_Click" />

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="12" Foreground="{StaticResource Subtle}" />
                        <TextBlock Text="Tus credenciales no se guardan en este dispositivo." Foreground="{StaticResource Subtle}"
                                   FontSize="12" TextWrapping="Wrap" Margin="8,0,0,0" MaxWidth="340" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== SHELL ===================== -->
        <Grid x:Name="ShellPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Barra lateral -->
            <Border Grid.Column="0" Background="{StaticResource Ink}">
                <DockPanel Margin="16,20,16,16">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="6,0,0,28">
                            <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource Teal}">
                                <TextBlock Text="V" Foreground="White" FontSize="17" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Vylersant" Foreground="White" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="Facturación" Foreground="{StaticResource TealMint}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>

                        <RadioButton x:Name="NavHome" GroupName="Nav" IsChecked="True" Tag="Inicio" Style="{StaticResource NavItem}" Click="Navigation_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" />
                                <TextBlock Text="Inicio" Margin="14,0,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavPos" GroupName="Nav" Tag="POS" Style="{StaticResource NavItem}" Click="Navigation_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BF;" />
                                <TextBlock Text="Punto de venta" Margin="14,0,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavInvoices" GroupName="Nav" Tag="Facturas" Style="{StaticResource NavItem}" Click="Navigation_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" />
                                <TextBlock Text="Facturas" Margin="14,0,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Nav" Tag="Productos" Style="{StaticResource NavItem}" Click="Navigation_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE719;" />
                                <TextBlock Text="Productos" Margin="14,0,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Nav" Tag="Clientes" Style="{StaticResource NavItem}" Click="Navigation_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE716;" />
                                <TextBlock Text="Clientes" Margin="14,0,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Usuario -->
                    <Border DockPanel.Dock="Bottom" Background="#203747" CornerRadius="12" Padding="12" VerticalAlignment="Bottom">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource InkSoft}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" Foreground="{StaticResource TealMint}"
                                               HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="130">
                                    <TextBlock x:Name="UserNameText" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="UserEmailText" Foreground="#AEBCC5" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                            <Button Style="{StaticResource SidebarButton}" Margin="0,12,0,0" Click="Logout_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="13" />
                                    <TextBlock Text="Cerrar sesión" Margin="8,0,0,0" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Contenido -->
            <Grid Grid.Column="1" Margin="28,24,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Cabecera (siempre visible, también en POS) -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock x:Name="PageTitleText" Text="Inicio" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                    <TextBlock x:Name="PageDescriptionText" Text="Tu espacio de trabajo está listo." FontSize="14"
                               Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- INICIO -->
                <StackPanel x:Name="HomeContent" Grid.Row="1">
                    <Border Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource Success}" VerticalAlignment="Center" />
                                <TextBlock Text="Sesión activa" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="10,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="SessionStatusText" Text="La aplicación está conectada a tu cuenta."
                                       Foreground="{StaticResource Muted}" Margin="20,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- PUNTO DE VENTA -->
                <Grid x:Name="PosContent" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Búsqueda y cliente -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Buscar producto" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,6" />
                            <Grid>
                                <TextBox x:Name="ProductSearchBox" Style="{StaticResource Input}" Height="46"
                                         Padding="42,0,12,0" FontSize="15" TextChanged="ProductSearch_TextChanged" />
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{StaticResource Subtle}"
                                           HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False" />
                                <TextBlock Text="Escribe el nombre o el código del producto" Foreground="#9AA8B3" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Margin="43,0,0,0" FontSize="15">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=ProductSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cliente (opcional)" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,6" />
                            <ComboBox Height="46" Padding="10,0" VerticalContentAlignment="Center" FontSize="14"
                                      ItemsSource="{Binding Customers}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1*" MinWidth="320" />
                        </Grid.ColumnDefinitions>

                        <!-- Catálogo -->
                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Products}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="196" Margin="0,0,12,12" Tag="{Binding}"
                                                        Style="{StaticResource ProductCard}" Click="AddProduct_Click">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Variable Display, Segoe UI"
                                                                   FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                                                   LineHeight="20" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                                   MinHeight="42" MaxHeight="42" />
                                                        <TextBlock Text="{Binding Sku}" Foreground="{StaticResource Muted}"
                                                                   FontFamily="Segoe UI" FontSize="11" Margin="0,5,0,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Price, StringFormat={}{0:C2}}"
                                                                   FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="22"
                                                                   FontWeight="SemiBold" Foreground="{StaticResource Teal}"
                                                                   Margin="0,9,0,13" />
                                                        <Border Background="{StaticResource Teal}" CornerRadius="8" Padding="0,8">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Foreground="White" />
                                                                <TextBlock Text="Agregar" Foreground="White" FontWeight="SemiBold" Margin="8,0,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Cargando -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Background="White"
                                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                                    <ProgressBar IsIndeterminate="True" Width="160" Height="4" Foreground="{StaticResource Teal}" Background="{StaticResource TealTint}" BorderThickness="0" />
                                    <TextBlock Text="Cargando catálogo…" Foreground="{StaticResource Muted}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                                </StackPanel>

                                <!-- Sin resultados -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Background="White"
                                            Visibility="{Binding HasNoProducts, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="34" Foreground="#B8C4CD" HorizontalAlignment="Center" />
                                    <TextBlock Text="No se encontraron productos" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                               FontSize="16" Margin="0,12,0,4" HorizontalAlignment="Center" />
                                    <TextBlock Text="Prueba con otro nombre o código, o revisa que el producto esté activo."
                                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" />
                                </StackPanel>

                                <!-- Error (solo si hay mensaje) -->
                                <Border Background="{StaticResource DangerTint}" CornerRadius="10" Padding="16,12" MaxWidth="420"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Carrito -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                            <DockPanel>
                                <!-- Encabezado -->
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                    <Border DockPanel.Dock="Right" Background="{StaticResource TealTint}" CornerRadius="10" Padding="10,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Cart.Count}" Foreground="{StaticResource Teal}" FontWeight="Bold" />
                                    </Border>
                                    <TextBlock Text="Carrito" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                </DockPanel>

                                <!-- Total -->
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                    <Border Background="{StaticResource Tile}" CornerRadius="12" Padding="16">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Subtotal, StringFormat={}{0:C2}}"
                                                       FontSize="26" FontWeight="Bold" Foreground="{StaticResource Teal}" />
                                            <TextBlock Text="Subtotal" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="Vista previa; el total final se calcula al crear la factura."
                                                   Foreground="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource DangerTint}" CornerRadius="10" Padding="11" Margin="0,10,0,0"
                                            >
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SaleErrorMessage}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SaleErrorMessage}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SaleErrorMessage}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                                    </Border>
                                    <Border Background="{StaticResource TealTint}" CornerRadius="10" Padding="11" Margin="0,10,0,0"
                                            Visibility="{Binding HasCreatedInvoice, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="Venta registrada" Foreground="{StaticResource TealDark}" FontWeight="SemiBold" />
                                            <TextBlock Foreground="{StaticResource Ink}" Margin="0,3,0,0">
                                                <Run Text="Factura #" /><Run Text="{Binding LastCreatedInvoice.Number}" /><Run Text=" · " />
                                                <Run Text="{Binding LastCreatedInvoice.Total, StringFormat={}{0:C2}}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" Foreground="{StaticResource Teal}"
                                                 Visibility="{Binding IsSubmitting, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="Confirmar venta" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"
                                            IsEnabled="{Binding CanSubmit}" Click="ConfirmSale_Click" />
                                </StackPanel>

                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Cart}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource Tile}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                            CornerRadius="12" Padding="12" Margin="0,0,6,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Ink}" TextWrapping="Wrap" Margin="0,4,8,0" />
                                                            <Button Grid.Row="0" Grid.Column="1" Tag="{Binding}" ToolTip="Quitar del carrito"
                                                                    Style="{StaticResource DangerIconButton}" Click="RemoveProduct_Click">
                                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12"
                                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                            </Button>

                                                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,10,0,0">
                                                                <Button Tag="{Binding}" ToolTip="Quitar una unidad"
                                                                        Style="{StaticResource IconButton}" Click="DecreaseQuantity_Click">
                                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE738;" FontSize="12" />
                                                                </Button>
                                                                <TextBlock Text="{Binding Quantity, StringFormat={}{0:0.##}}" MinWidth="40" TextAlignment="Center"
                                                                           VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource Ink}" />
                                                                <Button Tag="{Binding}" ToolTip="Agregar una unidad"
                                                                        Style="{StaticResource IconButton}" Click="IncreaseQuantity_Click">
                                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" />
                                                                </Button>
                                                            </StackPanel>
                                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LineTotal, StringFormat={}{0:C2}}"
                                                                       FontWeight="Bold" FontSize="15" Foreground="{StaticResource Ink}"
                                                                       VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Carrito vacío -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cart.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BF;" FontSize="38" Foreground="#B8C4CD" HorizontalAlignment="Center" />
                                        <TextBlock Text="Tu carrito está vacío" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource Ink}"
                                                   Margin="0,12,0,4" HorizontalAlignment="Center" />
                                        <TextBlock Text="Toca un producto para agregarlo a la venta." Foreground="{StaticResource Muted}"
                                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240" />
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
                <!-- HISTORIAL DE FACTURAS -->
                <Grid x:Name="InvoicesContent" Grid.Row="1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.3*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                <TextBlock Text="Facturas recientes" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                <TextBlock Text="{Binding TotalCount, StringFormat={}{0} facturas}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" />
                            </StackPanel>
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Invoices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Tag="{Binding}" Style="{StaticResource ProductCard}" Margin="0,0,4,8"
                                                        Click="InvoiceItem_Click" HorizontalContentAlignment="Stretch">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource Ink}"><Run Text="Factura #" /><Run Text="{Binding Number}" /></TextBlock>
                                                            <TextBlock Text="{Binding IssuedAtUtc, StringFormat={}{0:dd MMM yyyy · HH:mm}}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding Total, StringFormat={}{0:C2}}" FontWeight="Bold" Foreground="{StaticResource Ink}" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Teal}" FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                            Visibility="{Binding HasNoInvoices, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="34" Foreground="#B8C4CD" HorizontalAlignment="Center" />
                                    <TextBlock Text="Aún no hay facturas" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,10,0,3" HorizontalAlignment="Center" />
                                    <TextBlock Text="Las ventas completadas aparecerán aquí." Foreground="{StaticResource Muted}" TextAlignment="Center" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Background="White"
                                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                                    <ProgressBar IsIndeterminate="True" Width="150" Height="4" Foreground="{StaticResource Teal}" />
                                    <TextBlock Text="Cargando facturas…" Foreground="{StaticResource Muted}" Margin="0,10,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                                <Border Background="{StaticResource DangerTint}" CornerRadius="10" Padding="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers><DataTrigger Binding="{Binding HasDetails}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="38" Foreground="#B8C4CD" HorizontalAlignment="Center" />
                                <TextBlock Text="Selecciona una factura" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,12,0,4" HorizontalAlignment="Center" />
                                <TextBlock Text="Aquí verás las líneas y los datos guardados al emitirla." Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="330" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{StaticResource TealTint}" CornerRadius="10" Padding="10,5">
                                        <TextBlock Text="{Binding Details.Status}" Foreground="{StaticResource TealDark}" FontWeight="SemiBold" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock FontSize="23" FontWeight="Bold" Foreground="{StaticResource Ink}"><Run Text="Factura #" /><Run Text="{Binding Details.Number}" /></TextBlock>
                                        <TextBlock Text="{Binding Details.IssuedAtUtc, StringFormat={}{0:dd MMMM yyyy · HH:mm}}" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding Details.CustomerName, TargetNullValue=Venta sin cliente}" Foreground="{StaticResource InkSoft}" Margin="0,18,0,12" />
                                <Separator Background="{StaticResource Line}" />
                                <TextBlock Text="Detalle" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,14,0,8" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="340">
                                    <ItemsControl ItemsSource="{Binding Details.Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                                        <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"><Run Text="{Binding Quantity, StringFormat={}{0:0.##}}" /><Run Text=" × " /><Run Text="{Binding UnitPrice, StringFormat={}{0:C2}}" /></TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding LineTotal, StringFormat={}{0:C2}}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Border Background="{StaticResource Tile}" CornerRadius="12" Padding="16" Margin="0,12,0,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Details.Total, StringFormat={}{0:C2}}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Teal}" />
                                        <TextBlock Text="Total" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Background="White"
                                        Visibility="{Binding IsLoadingDetails, Converter={StaticResource BoolToVisibility}}">
                                <ProgressBar IsIndeterminate="True" Width="150" Height="4" Foreground="{StaticResource Teal}" />
                                <TextBlock Text="Cargando detalle…" Foreground="{StaticResource Muted}" Margin="0,10,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Border Background="{StaticResource DangerTint}" CornerRadius="10" Padding="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DetailsErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            <DataTrigger Binding="{Binding DetailsErrorMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding DetailsErrorMessage}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

